[flake8]
# Flake8 configuration for StyleMe CI
max-line-length = 120
extend-ignore = E203,E501,W503,E402,D,I100,I101,I201,F401,E722,F541,W291,W293,E128,F811,W292,W391,E129,F821,E305,E302,C901,F841
# D*: All docstring checks disabled (can be enabled later)
# I*: Import order checks disabled (can be enabled later)
# F401: Unused imports (can be fixed later)
# E722: Bare except (can be fixed later)
# F541: f-string placeholders (can be fixed later)
# W291,W293: Whitespace issues (can be fixed later)
# E128: Continuation line indentation (can be fixed later)
# F811: Redefinition (can be fixed later)
# W292: No newline at end of file (can be fixed later)
# E203: whitespace before ':'
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator
# E402: module level import not at top of file (needed for some modules)
# D200,D400,D205: docstring formatting (relaxed for now)
# I100,I101,I201: import order (relaxed for now)
# F401: unused imports (relaxed for now)
# E722: bare except (relaxed for now)
# F541: f-string placeholders (relaxed for now)
# W291,W293: whitespace issues (relaxed for now)
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .coverage,
    htmlcov,
    experiments,
    catalog,
    wardrobes,
    data,
    logs,
    results,
    queries,
    containers/*/__pycache__,
    src/*/__pycache__,
    src/*/*/__pycache__
per-file-ignores =
    __init__.py:F401
max-complexity = 15

