[run]
# Coverage configuration for StyleMe CI
source = src,containers
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */experiments/*
    */catalog/*
    */wardrobes/*
    */data/*
    */logs/*
    */results/*
    */queries/*
    */examples/*
    */__init__.py
    */setup.py
    */config.py
    */entrypoint.sh
    */Dockerfile
    */README.md
    */TEST.md
    */BACKGROUND_REMOVAL_GUIDE.md
    */CONTAINERIZATION.md
    */INFERENCE_*.md
    */run_training.sh
    */build_*.py
    */retry_failed.py
    */containers/inference/inference_service.py
    */src/models/train/model_training.py
    */src/datapipeline/dataloader.py
    */src/datapipeline/bg_removal/batch_processor.py
    */src/datapipeline/bg_removal/finetune_background_removal.py
    */src/datapipeline/bg_removal/background_removal_fast.py
    */src/datapipeline/scraper/retry_failed.py
    */containers/inference/build_catalog_index.py
    */containers/inference/build_user_wardrobe.py
    */src/models/eval/evaluation.py
    */src/models/train/run_fine_tuning.py
    */src/models/train/fine_tune_config.py

[report]
# Minimum coverage requirement: 60%
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = CI/coverage_html

[xml]
output = CI/coverage.xml

